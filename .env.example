# Seller's USDC wallet address on Base network
# Replace with your actual Base wallet address after setup
WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# Network: "base" for mainnet, "base-sepolia" for testnet
NEXT_PUBLIC_NETWORK=base-sepolia

# WalletConnect Project ID (get one free at https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here
